{
  "name": "dsh-rea",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "REA (Reverse Engineer Anything) MCP bridge for DeepSeek Harness — reverse engineer/decompile native binaries, APK classes & resources, .NET assemblies, JS/Electron apps, firmware and websites through mcp__rea__* tools.",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "reverse-engineering",
    "decompiler"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "dsh.plugin.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
